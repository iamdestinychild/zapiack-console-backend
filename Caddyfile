# Caddy sits in front of admin-core on the droplet and terminates TLS.
#
# Certificates are issued and renewed automatically, so ADMIN_DOMAIN must already
# resolve to this droplet before the container starts, and ports 80 and 443 must be
# reachable. ACME_EMAIL is where Let's Encrypt sends expiry warnings.
{
	email {$ACME_EMAIL}
	# Staging CA while testing, so a broken DNS record does not burn the rate limit:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	servers {
		# Trust the forwarded headers only from the container network, never from clients.
		trusted_proxies static private_ranges
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The console is the only thing that should ever embed or call this host.
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# ---------------------------------------------------------------- health
	# Answers without touching the app's logs; used by uptime checks.
	handle /health* {
		reverse_proxy admin-core:3001
	}

	# ---------------------------------------------------------------- SSE
	# The live map and the staff inbox are long-lived text/event-stream responses.
	# flush_interval -1 disables response buffering; without it Caddy holds events
	# until the buffer fills and the map appears frozen.
	@sse path /admin/v1/geo/live /admin/v1/events
	handle @sse {
		reverse_proxy admin-core:3001 {
			flush_interval -1
			transport http {
				# A stream is idle between events; do not cut it for being quiet.
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# ---------------------------------------------------------------- downloads
	# Sender ID zips stream from S3 through admin-core and can take a while.
	@downloads path_regexp zip ^/admin/v1/sender-ids/[^/]+/documents\.zip$
	handle @downloads {
		reverse_proxy admin-core:3001 {
			flush_interval -1
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	# ---------------------------------------------------------------- everything else
	handle {
		# Caddy forwards X-Forwarded-For and X-Forwarded-Proto by default, and
		# admin-core is configured to trust exactly one proxy hop. The IP allowlist,
		# the God's-eye map and every audit entry read the client address from there,
		# so if this ever moves behind a second proxy, raise `trust proxy` to match.
		reverse_proxy admin-core:3001 {
			header_up X-Real-IP {remote_host}

			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	log {
		output file /var/log/caddy/admin-core.log {
			roll_size 50MiB
			roll_keep 7
		}
		format json
	}
}
