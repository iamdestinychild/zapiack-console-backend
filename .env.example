# admin-core — copy to .env for local development.
# Nothing in here is a real secret; production values come from the secrets manager.

NODE_ENV=development
PORT=3001
ADMIN_TIMEZONE=Africa/Lagos

# The console origin, and nothing else. CORS is strict and credentials are on.
ADMIN_CORS_ORIGIN=http://localhost:3000

# --- docker-compose ------------------------------------------------------------
# Consumed by docker-compose.yml, which brings up Postgres and Redis locally.
# The connection strings below must agree with these.
# Ports differ from the zapiack-backend stack (5432 / 6379) so both can run at once.
DB_USERNAME=zapiack_admin
DB_PASSWORD=devpassword
DB_NAME=zapiack_admin
DB_PORT=5433
REDIS_PORT=6380
REDIS_PASSWORD=devpassword

# --- databases -----------------------------------------------------------------
# admin-core owns this one outright.
ADMIN_DATABASE_URL=postgresql://zapiack_admin:devpassword@localhost:5433/zapiack_admin
# The read replica, through a role with SELECT and nothing else.
# Locally this is the mirror database created by docker/postgres-init. To develop
# against real product data instead, point this at the zapiack-backend stack:
#   postgresql://<user>:<pass>@localhost:5432/zapiack
ZAPIACK_READ_DATABASE_URL=postgresql://zapiack_admin:devpassword@localhost:5433/zapiack
DB_POOL_MAX=10

# --- redis ---------------------------------------------------------------------
REDIS_URL=redis://:devpassword@localhost:6380
# Distinct from the customer app, so no key or token can ever be shared.
REDIS_KEY_PREFIX=admin-core:

# --- session -------------------------------------------------------------------
# Distinct cookie names too: a customer token must never satisfy an admin guard.
ADMIN_ACCESS_COOKIE=zpk_admin_at
ADMIN_REFRESH_COOKIE=zpk_admin_rt
ADMIN_CSRF_COOKIE=zpk_admin_csrf
ADMIN_JWT_SECRET=change-me-to-at-least-32-random-characters
ADMIN_SESSION_ABSOLUTE_TTL=43200   # 12 hours
ADMIN_SESSION_IDLE_TTL=1800        # 30 minutes
ADMIN_SECURE_COOKIES=false
# ADMIN_COOKIE_DOMAIN=admin.zapiack.com

# --- auth ----------------------------------------------------------------------
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_INVITE_TTL_HOURS=48
ADMIN_TOTP_ISSUER=Zapiack Admin
ADMIN_IMPERSONATION_MINUTES=30

# --- thresholds ----------------------------------------------------------------
CREDIT_APPROVAL_THRESHOLD_NGN=100000   # above this, a second approver is required
BROADCAST_APPROVAL_THRESHOLD=1000      # above this, a broadcast needs super admin
DOCUMENT_URL_TTL_SECONDS=300           # presigned sender ID document links
EXPORT_TTL_HOURS=24
REQUEST_LOG_RETENTION_DAYS=90
LIVE_MAP_EPS=50                        # live map events per second per viewer
RECONCILIATION_VARIANCE_PCT=1
ROLLUP_LAG_ALERT_MINUTES=15

# --- api-core ------------------------------------------------------------------
# Every product write goes through here; admin-core never writes the Zapiack DB.
API_CORE_BASE_URL=http://localhost:3000/internal/v1
API_CORE_SERVICE_TOKEN=
API_CORE_SIGNING_SECRET=
API_CORE_TIMEOUT_MS=10000

# --- aws -----------------------------------------------------------------------
AWS_REGION=eu-west-1
# Private, server-side encrypted, public access blocked. admin-core's IAM role is
# read-only and scoped to the prefix below.
S3_SENDER_ID_BUCKET=zapiack-sender-id-documents
S3_SENDER_ID_PREFIX=sender-ids/
S3_EXPORT_BUCKET=zapiack-admin-exports
S3_EXPORT_PREFIX=exports/

SES_REGION=eu-west-1
SES_FROM_ADDRESS=no-reply@zapiack.com
# SES_REPLY_TO=support@zapiack.com

# --- geoip ---------------------------------------------------------------------
# Local MaxMind GeoLite2 City database, refreshed weekly. No per-request lookup.
GEOIP_CITY_DB_PATH=./data/GeoLite2-City.mmdb

# --- sms-core ------------------------------------------------------------------
# The console dogfoods the product; these sends are accounted as internal usage.
SMS_CORE_BASE_URL=
SMS_CORE_API_KEY=
SMS_CORE_SENDER_ID=Zapiack

# --- seed (first run only) ------------------------------------------------------
# ADMIN_SEED_EMAIL=you@zapiack.com
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=
