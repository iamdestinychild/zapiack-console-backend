# Environment for the Render web service `zapiack-admin-core`.
#
# TWO WAYS TO CREATE THE SERVICE, and they differ in what you must add by hand.
#
# A) New > Blueprint (reads render.yaml). Render sets or generates the block below for
#    you, so leave it out. Everything under "yours to provide" is prompted.
#
# B) New > Web Service (by hand). render.yaml is NOT read, so you must add this block
#    yourself, or the container exits on start with
#    "Missing required environment variables: REDIS_URL, ADMIN_JWT_SECRET":
#
#      ADMIN_JWT_SECRET=<openssl rand -base64 48>
#      REDIS_URL=<the INTERNAL url of a Render Key Value instance in the same region>
#      ADMIN_RUN_MIGRATIONS=true      # without it the Admin DB is never created
#
#    Also, in the service's Settings: Health Check Path = /health, and create the Key
#    Value instance first (New > Key Value, free, same region, maxmemory policy
#    noeviction, no external access).
#
# NODE_ENV and ADMIN_ROLE are baked into the Docker image (production and all), and
# ADMIN_TIMEZONE and ADMIN_SECURE_COOKIES default correctly, so none of those are needed.
#
# Nothing in this file is a secret. Replace every <...>.

# --- databases ---------------------------------------------------------------------
# The Admin DB: staff, roles, the audit log, review decisions. A SEPARATE Neon project
# from the product database, on a plan that does not expire. Use the owner role.
ADMIN_DATABASE_URL=postgresql://<owner>:<password>@<admin-host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# The product database. These are the least-privilege roles from
# prisma/grants/zapiack-roles.sql, NOT the product's own owner credentials.
ZAPIACK_READ_DATABASE_URL=postgresql://admin_reader:<reader-password>@<product-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
ZAPIACK_WRITE_DATABASE_URL=postgresql://admin_writer:<writer-password>@<product-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Neon's free tier allows few connections; keep each pool small.
DB_POOL_MAX=3

# --- where the console lives -------------------------------------------------------
# Exact origin of the console, no trailing slash, no wildcard.
ADMIN_CORS_ORIGIN=https://console.<your-domain>
# The parent domain both the console and this API sit under. The session cookie is
# SameSite=Strict, so the two must be on the same site.
ADMIN_COOKIE_DOMAIN=<your-domain>

# --- api-core ----------------------------------------------------------------------
# The console asks api-core to do the things that must not bypass its ledger rules:
# credit adjustments, force-logout, plan changes. Those internal endpoints are not built
# yet, so until they are, those actions return a 5xx. Everything else works.
API_CORE_BASE_URL=https://<your-api-domain>/internal/v1
# Generate each with:  openssl rand -hex 32
# api-core must be configured with the same two values when its internal routes exist.
API_CORE_SERVICE_TOKEN=<random-64-hex>
API_CORE_SIGNING_SECRET=<random-64-hex>

# --- AWS: exports and email --------------------------------------------------------
# Use a dedicated IAM user, not the product's. It needs s3:PutObject and s3:GetObject on
# the exports bucket and ses:SendEmail, and nothing else.
AWS_REGION=<region>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
S3_EXPORT_BUCKET=<private-exports-bucket>
SES_FROM_ADDRESS=<verified-sender@your-domain>
