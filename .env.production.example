# Environment for admin-core on the APP droplet:  /opt/zapiack-admin/.env.production
#
# Copy this file there, replace every <...>, then:  chmod 600 .env.production
# Nothing in this file is a secret until you fill it in. Never commit the filled-in copy.
#
# NODE_ENV, PORT and ADMIN_ROLE are set by the Dockerfile and docker-compose.prod.yml,
# and ADMIN_TIMEZONE / ADMIN_SECURE_COOKIES default correctly, so none are needed here.
#
# <DATA_IP> is the DATA droplet's PRIVATE (VPC) address, the same one the main app's
# .env.production uses. Traffic on it never leaves the datacentre network, which is why
# these URLs say sslmode=disable. Do NOT use that setting across the public internet.

# --- Admin database ----------------------------------------------------------------
# Staff, roles, the audit log, review decisions. A database of its own on the data
# droplet's Postgres, created by deploy/data-droplet/admin-db.sql.
ADMIN_DATABASE_URL=postgresql://admin_core:<admin-password>@<DATA_IP>:5432/zapiack_admin?sslmode=disable

# --- Product database --------------------------------------------------------------
# The main app's database, through the two least-privilege roles that
# prisma/grants/zapiack-roles.sql creates. NOT the main app's owner credentials.
ZAPIACK_READ_DATABASE_URL=postgresql://admin_reader:<reader-password>@<DATA_IP>:5432/zapiack?sslmode=disable
ZAPIACK_WRITE_DATABASE_URL=postgresql://admin_writer:<writer-password>@<DATA_IP>:5432/zapiack?sslmode=disable

# The data droplet allows 100 connections and the main app uses about 40. admin-core
# opens three pools; this keeps it near 12 in total.
DB_POOL_MAX=4

# --- Redis -------------------------------------------------------------------------
# The data droplet's Redis, which runs with noeviction (queued jobs and sessions are
# never silently dropped). The trailing /1 is a separate database inside it, so none of
# the main app's keys are visible to admin-core or the other way round. The password is
# the same REDIS_PASSWORD the main app uses.
REDIS_URL=redis://:<redis-password>@<DATA_IP>:6379/1
REDIS_KEY_PREFIX=admin-core:

# --- Security ----------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
ADMIN_JWT_SECRET=<random>

# --- Where the console lives -------------------------------------------------------
# Exact origin of the console, no trailing slash, no wildcard.
ADMIN_CORS_ORIGIN=https://console.zapiack.com
# The parent domain the console and this API share, so the session cookie is sent to both.
ADMIN_COOKIE_DOMAIN=zapiack.com

# --- api-core ----------------------------------------------------------------------
# Reached over the droplet's internal Docker network, never the public address. The
# internal endpoints behind credit adjustments, force-logout and plan changes are not
# built in api-core yet, so those three actions return an error until they are.
API_CORE_BASE_URL=http://api-core:3001/internal/v1
# Generate each with:  openssl rand -hex 32
API_CORE_SERVICE_TOKEN=<random-64-hex>
API_CORE_SIGNING_SECRET=<random-64-hex>

# Template review. api-core's admin routes are guarded by a shared key; this must equal
# ADMIN_API_KEY in the main app's .env.production. Without it the template review
# endpoints answer 503 and nothing else is affected.
API_CORE_ADMIN_KEY=<same value as ADMIN_API_KEY in the main app>
API_CORE_ADMIN_BASE_URL=http://api-core:3001/v1

# --- AWS: exports and email --------------------------------------------------------
# A dedicated IAM user, not the product's. It needs s3:PutObject and s3:GetObject on the
# exports bucket and ses:SendEmail, and nothing else.
AWS_REGION=<region>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
S3_EXPORT_BUCKET=<private-exports-bucket>
SES_FROM_ADDRESS=<verified-sender@zapiack.com>
