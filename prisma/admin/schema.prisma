// Admin DB — owned by admin-core. Everything that exists only because staff exist.
// No cross-database foreign keys: product entities are referenced by id and may vanish.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/admin"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
// ---------------------------------------------------------------- staff & access

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // super_admin, finance, support, compliance, ops, growth, read_only
  name        String
  description String?
  /// Granular permission strings, e.g. customers.read, credits.adjust.
  permissions String[]
  /// Optional CIDR allowlist; empty means no network restriction for this role.
  ipAllowlist String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff   Staff[]
  invites StaffInvite[]

  @@map("roles")
}

model Staff {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  passwordHash String
  /// Encrypted TOTP secret. 2FA is mandatory; enrolment completes at first login.
  totpSecret   String?
  totpEnabled  Boolean     @default(false)
  status       StaffStatus @default(ACTIVE)
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  /// Per-staff overrides layered on top of the role bundle.
  extraPermissions String[] @default([])

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  /// Bumped on role change; sessions minted before this are rejected.
  sessionEpoch     Int       @default(0)

  emailNotificationPrefs String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            StaffSession[]
  auditEntries        AuditLog[]
  notes               CustomerNote[]
  notifications       StaffNotification[]
  requestedAdjustments CreditAdjustment[] @relation("AdjustmentRequester")
  approvedAdjustments  CreditAdjustment[] @relation("AdjustmentApprover")
  reviews             SenderIdReview[]
  campaigns           Campaign[]
  exports             ExportJob[]
  impersonations      ImpersonationSession[]

  @@index([status])
  @@map("staff")
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

model StaffInvite {
  id         String    @id @default(uuid())
  email      String
  name       String
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id])
  tokenHash  String    @unique
  invitedById String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("staff_invites")
}

/// Mirror of the Redis session, kept for force-logout and audit. Redis is authoritative for liveness.
model StaffSession {
  id           String    @id @default(uuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?
  country      String?
  city         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// 12-hour absolute lifetime.
  absoluteExpiresAt DateTime
  revokedAt    DateTime?
  revokedReason String?

  @@index([staffId, revokedAt])
  @@map("staff_sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}

/// Read-only, time-boxed "view as customer".
model ImpersonationSession {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  accountId String
  reason    String
  startedAt DateTime @default(now())
  expiresAt DateTime
  endedAt   DateTime?

  @@index([accountId])
  @@map("impersonation_sessions")
}

// ---------------------------------------------------------------- audit

/// Append-only. No role, including super admin, may update or delete rows;
/// enforced by a database trigger in the migration, not just by application code.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      Staff?   @relation(fields: [actorId], references: [id])
  actorEmail String?
  action     String   // e.g. customers.suspend, senderid.document.download
  targetType String?  // account, sender_id_application, staff, campaign...
  targetId   String?
  /// Snapshots for changes; null for reads.
  before     Json?
  after      Json?
  reason     String?
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

/// Replay protection for write routes carrying an Idempotency-Key.
model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String
  staffId      String
  route        String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([key, staffId, route])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------- customer annotations

model CustomerNote {
  id        String   @id @default(uuid())
  accountId String
  authorId  String
  author    Staff    @relation(fields: [authorId], references: [id])
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, createdAt])
  @@map("customer_notes")
}

model CustomerTag {
  id        String   @id @default(uuid())
  accountId String
  tag       String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([accountId, tag])
  @@map("customer_tags")
}

model RiskFlag {
  id         String       @id @default(uuid())
  accountId  String
  type       RiskFlagType
  severity   RiskSeverity @default(MEDIUM)
  source     RiskSource   @default(AUTOMATIC)
  summary    String
  evidence   Json?
  raisedBy   String?
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?
  createdAt  DateTime     @default(now())

  @@index([accountId, resolvedAt])
  @@index([type, createdAt])
  @@map("risk_flags")
}

enum RiskFlagType {
  VOLUME_SPIKE
  HIGH_FAILURE_RATE
  MANY_DESTINATION_COUNTRIES
  MANY_SIGNIN_COUNTRIES
  SMS_PUMPING_SUSPECTED
  PAYMENT_FAILURE_SPIKE
  MANUAL
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskSource {
  AUTOMATIC
  MANUAL
}

// ---------------------------------------------------------------- pricing & cost

/// Provider cost per unit, versioned. History is never overwritten so past profit stays correct.
model ProviderCost {
  id            String    @id @default(uuid())
  provider      String    // e.g. termii, ses, 360dialog, africastalking
  channel       String    // ChannelType key mirrored from the Zapiack DB
  /// Optional narrowing: destination country (ISO-2) and mobile network.
  country       String?
  network       String?
  unitCostNgn   Decimal   @db.Decimal(19, 4)
  currency      String    @default("NGN")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([channel, provider, effectiveFrom])
  @@map("provider_costs")
}

model MarginTarget {
  id            String   @id @default(uuid())
  channel       String
  targetMargin  Decimal  @db.Decimal(5, 4) // 0.3500 = 35%
  effectiveFrom DateTime
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([channel, effectiveFrom])
  @@map("margin_targets")
}

// ---------------------------------------------------------------- credits

model CreditAdjustment {
  id             String                 @id @default(uuid())
  accountId      String
  direction      AdjustmentDirection
  amountNgn      Decimal                @db.Decimal(19, 4)
  reason         String
  status         AdjustmentStatus       @default(PENDING_APPROVAL)
  /// Passed to api-core so the ledger write is replay-safe.
  idempotencyKey String                 @unique

  requestedById  String
  requestedBy    Staff                  @relation("AdjustmentRequester", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     Staff?                 @relation("AdjustmentApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?

  /// Ledger transaction id returned by api-core once applied.
  ledgerTxnId    String?
  appliedAt      DateTime?
  failureReason  String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@map("credit_adjustments")
}

enum AdjustmentDirection {
  CREDIT
  DEBIT
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  APPLIED
  REJECTED
  FAILED
}

// ---------------------------------------------------------------- rollups

/// Idempotent bucket: re-running a window upserts and never double-counts.
model UsageRollup {
  id          String   @id @default(uuid())
  /// Africa/Lagos calendar day.
  date        DateTime @db.Date
  /// 0-23 in Africa/Lagos; -1 marks the finalised daily row.
  hour        Int
  channel     String
  accountId   String
  planId      String?
  country     String   @default("UNKNOWN")
  provider    String   @default("UNKNOWN")

  attempted   BigInt   @default(0)
  succeeded   BigInt   @default(0)
  failed      BigInt   @default(0)
  units       BigInt   @default(0)

  revenueNgn  Decimal  @default(0) @db.Decimal(19, 4)
  costNgn     Decimal  @default(0) @db.Decimal(19, 4)

  latencyP50Ms Int?
  latencyP95Ms Int?

  finalisedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([date, hour, channel, accountId, country, provider])
  @@index([date, channel])
  @@index([accountId, date])
  @@map("usage_rollups")
}

/// Cash view: Paystack collections, fees and refunds, kept apart from recognised revenue.
model CashRollup {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  collectedNgn  Decimal  @default(0) @db.Decimal(19, 4)
  refundedNgn   Decimal  @default(0) @db.Decimal(19, 4)
  feesNgn       Decimal  @default(0) @db.Decimal(19, 4)
  paymentCount  Int      @default(0)
  failedCount   Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([date])
  @@map("cash_rollups")
}

/// Subscription revenue and credit liability snapshots taken at end of day.
model FinanceSnapshot {
  id                  String   @id @default(uuid())
  date                DateTime @db.Date
  subscriptionRevenueNgn Decimal @default(0) @db.Decimal(19, 4)
  creditLiabilityNgn  Decimal  @default(0) @db.Decimal(19, 4)
  mrrNgn              Decimal  @default(0) @db.Decimal(19, 4)
  activeAccounts      Int      @default(0)
  newAccounts         Int      @default(0)
  activatedAccounts   Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@unique([date])
  @@map("finance_snapshots")
}

model RequestRollup {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  hour        Int
  accountId   String?
  endpoint    String
  method      String
  country     String   @default("UNKNOWN")
  total       BigInt   @default(0)
  clientErrors BigInt  @default(0)
  serverErrors BigInt  @default(0)
  latencyP50Ms Int?
  latencyP95Ms Int?
  updatedAt   DateTime @updatedAt

  @@unique([date, hour, accountId, endpoint, method, country])
  @@index([date, country])
  @@map("request_rollups")
}

model RollupWatermark {
  id          String   @id @default(uuid())
  job         String   @unique
  /// Last window this job has completed, used to detect rollup lag.
  processedTo DateTime
  lastRunAt   DateTime @default(now())
  lastError   String?

  @@map("rollup_watermarks")
}

// ---------------------------------------------------------------- reconciliation & exports

model ReconciliationRun {
  id        String                  @id @default(uuid())
  date      DateTime                @db.Date
  kind      ReconciliationKind
  status    ReconciliationStatus    @default(OK)
  expectedNgn Decimal               @db.Decimal(19, 4)
  actualNgn   Decimal               @db.Decimal(19, 4)
  variancePct Decimal               @db.Decimal(9, 6)
  detail    Json?
  createdAt DateTime                @default(now())

  @@unique([date, kind])
  @@map("reconciliation_runs")
}

enum ReconciliationKind {
  PAYSTACK_SETTLEMENT
  PROVIDER_INVOICE
}

enum ReconciliationStatus {
  OK
  VARIANCE
  FAILED
}

model ExportJob {
  id          String       @id @default(uuid())
  requestedById String
  requestedBy Staff        @relation(fields: [requestedById], references: [id])
  kind        String       // revenue, profit, ledger, customers, audit...
  params      Json
  containsPii Boolean      @default(false)
  status      ExportStatus @default(QUEUED)
  rowCount    Int?
  objectKey   String?
  /// PII exports expire after 24 hours.
  expiresAt   DateTime?
  error       String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([requestedById, createdAt])
  @@map("export_jobs")
}

enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

// ---------------------------------------------------------------- geo & request log

/// Raw request log, 90-day retention, daily partitions created by a maintenance job.
/// Partitioning is applied in SQL (see prisma/admin/migrations) — Prisma models the shape only.
model RequestLog {
  id         String   @default(uuid())
  occurredAt DateTime
  accountId  String?
  apiKeyId   String?
  endpoint   String
  method     String
  statusCode Int
  latencyMs  Int
  /// Raw IP is PII: only surfaced with pii.reveal.
  ip         String?
  userAgent  String?
  country    String?
  region     String?
  city       String?
  latitude   Float?
  longitude  Float?
  requestId  String?

  @@id([id, occurredAt])
  @@index([occurredAt])
  @@index([accountId, occurredAt])
  @@index([country, occurredAt])
  @@map("request_logs")
}

/// Sign-ins from both the customer app and the console.
model SignInEvent {
  id         String   @id @default(uuid())
  surface    SignInSurface
  accountId  String?
  userId     String?
  staffId    String?
  email      String?
  success    Boolean  @default(true)
  ip         String?
  country    String?
  region     String?
  city       String?
  latitude   Float?
  longitude  Float?
  userAgent  String?
  occurredAt DateTime @default(now())

  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@map("signin_events")
}

enum SignInSurface {
  CUSTOMER_APP
  ADMIN_CONSOLE
}

/// Where messages are going, which is where SMS-pumping fraud shows up.
model DestinationRollup {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  channel   String
  accountId String
  country   String
  network   String?
  attempted BigInt   @default(0)
  delivered BigInt   @default(0)
  costNgn   Decimal  @default(0) @db.Decimal(19, 4)
  updatedAt DateTime @updatedAt

  @@unique([date, channel, accountId, country, network])
  @@index([date, country])
  @@map("destination_rollups")
}

// ---------------------------------------------------------------- sender ID review

model SenderIdReview {
  id            String            @id @default(uuid())
  /// Application id in the Zapiack DB. No FK across databases.
  applicationId String            @unique
  accountId     String
  senderId      String
  status        SenderIdStatus    @default(SUBMITTED)
  assigneeId    String?
  assignee      Staff?            @relation(fields: [assigneeId], references: [id])
  submittedAt   DateTime
  /// SLA target; queue timers count against this.
  slaDueAt      DateTime
  decidedAt     DateTime?
  decisionReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  events     SenderIdReviewEvent[]
  checklist  SenderIdChecklistItem[]

  @@index([status, slaDueAt])
  @@index([assigneeId, status])
  @@map("sender_id_reviews")
}

enum SenderIdStatus {
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  SUBMITTED_TO_OPERATORS
  ACTIVE
  OPERATOR_REJECTED
  SUSPENDED
}

model SenderIdReviewEvent {
  id        String         @id @default(uuid())
  reviewId  String
  review    SenderIdReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fromStatus SenderIdStatus?
  toStatus   SenderIdStatus
  actorId   String?
  comment   String?
  createdAt DateTime       @default(now())

  @@index([reviewId, createdAt])
  @@map("sender_id_review_events")
}

model SenderIdChecklistItem {
  id       String         @id @default(uuid())
  reviewId String
  review   SenderIdReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  key      String         // business_registration_matches, loa_signed, matches_brand, sample_content_ok
  label    String
  passed   Boolean?
  note     String?
  checkedBy String?
  checkedAt DateTime?

  @@unique([reviewId, key])
  @@map("sender_id_checklist_items")
}

// ---------------------------------------------------------------- outbound comms

model Segment {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  /// Declarative filter compiled to a Zapiack DB read; see SegmentFilterDto.
  filter      Json
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@map("segments")
}

model NotificationTemplate {
  id        String            @id @default(uuid())
  key       String            @unique
  name      String
  channel   NotificationChannel
  subject   String?
  body      String
  /// Variable names the body expects, e.g. ["account.businessName"].
  variables String[]          @default([])
  createdBy String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  campaigns Campaign[]

  @@map("notification_templates")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Campaign {
  id          String              @id @default(uuid())
  name        String
  channel     NotificationChannel
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  subject     String?
  body        String

  audienceKind AudienceKind
  segmentId   String?
  segment     Segment?            @relation(fields: [segmentId], references: [id])
  /// Hand-picked account ids when audienceKind is ACCOUNT_LIST or SINGLE_ACCOUNT.
  accountIds  String[]            @default([])

  status      CampaignStatus      @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  recipientCount Int              @default(0)
  sentCount      Int              @default(0)
  deliveredCount Int              @default(0)
  failedCount    Int              @default(0)
  /// Internal usage cost; excluded from customer revenue.
  internalCostNgn Decimal         @default(0) @db.Decimal(19, 4)

  /// Broadcasts above the approval threshold need a super admin.
  requiresApproval Boolean        @default(false)
  approvedById  String?
  approvedAt    DateTime?

  createdById String
  createdBy   Staff               @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  recipients CampaignRecipient[]

  @@index([status, scheduledAt])
  @@map("campaigns")
}

enum AudienceKind {
  SINGLE_ACCOUNT
  ACCOUNT_LIST
  SEGMENT
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model CampaignRecipient {
  id          String          @id @default(uuid())
  campaignId  String
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId   String
  /// Masked at rest for SMS/email campaigns; reveal needs pii.reveal.
  destination String?
  status      RecipientStatus @default(PENDING)
  providerRef String?
  failureReason String?
  sentAt      DateTime?
  deliveredAt DateTime?

  @@unique([campaignId, accountId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------- staff inbox & health

model StaffNotification {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type      String   // senderid.submitted, sla.breach, payment.failure_spike, provider.outage...
  severity  RiskSeverity @default(MEDIUM)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime @default(now())

  @@index([staffId, readAt, createdAt])
  @@map("staff_notifications")
}

model ProviderHealthSample {
  id            String   @id @default(uuid())
  provider      String
  channel       String
  windowStart   DateTime
  windowEnd     DateTime
  attempted     BigInt   @default(0)
  delivered     BigInt   @default(0)
  failed        BigInt   @default(0)
  avgDlrLatencyMs Int?
  errorRate     Decimal  @default(0) @db.Decimal(5, 4)
  status        ProviderStatus @default(HEALTHY)

  @@unique([provider, channel, windowStart])
  @@index([channel, windowStart])
  @@map("provider_health_samples")
}

enum ProviderStatus {
  HEALTHY
  DEGRADED
  OUTAGE
}

/// Persist-first inbox for events consumed from api-core / sms-core / mailing-core.
/// A reconciliation sweep re-queues anything still PENDING.
model IngestedEvent {
  id          String      @id @default(uuid())
  eventId     String      @unique
  type        String
  source      String
  payload     Json
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  receivedAt  DateTime    @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([type, receivedAt])
  @@map("ingested_events")
}

enum EventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}
